{
  "name": "mediaforge",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Production-oriented authorized public media analysis and download system.",
  "engines": {"node": ">=20"},
  "scripts": {
    "dev": "node --watch backend/server.js",
    "start": "node backend/server.js",
    "build": "tsc && node scripts/copy-frontend.mjs",
    "test": "node --test tests/backend/*.test.js tests/integration/*.test.js",
    "lint": "node scripts/lint.mjs",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.1.0",
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
